# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/investiq

# Generate a unique value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=30d
INITIAL_COINS=100000

# Optional email delivery (Resend preferred; requires a verified sending domain for real users)
RESEND_API_KEY=
EMAIL_FROM=InvestIQ <onboarding@resend.dev>
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Optional AI integrations
GROQ_API_KEY=

# Optional Razorpay integration (test keys only until ready for live payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MERCHANT_UPI_ID=
MERCHANT_NAME=InvestIQ

# Optional separately deployed Python ML service
ML_SERVER_URL=http://localhost:5001
